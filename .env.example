KIT_SHARED_TOKEN=
KIT_WORKSPACE=./workspace
KIT_BIND=127.0.0.1
KIT_PORT=3100
KIT_CONFIG=./kit.yaml

# Artifacts
ARTIFACT_MAX_BYTES=524288000
ARTIFACT_TTL_SEC=86400

# Python sandbox
SANDBOX_NETWORK=false
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MAX_OUTPUT_BYTES=1048576

# Optional child tokens (names only — set locally)
# GITHUB_PERSONAL_ACCESS_TOKEN=
# CHILD_MOBILE_TOKEN=
